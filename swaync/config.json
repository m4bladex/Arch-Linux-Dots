{
"$schema": "/etc/xdg/swaync/configSchema.json",

"ignore-gtk-theme": true,

"positionX": "right",
"positionY": "top",

"layer": "overlay",
"control-center-layer": "overlay",

"layer-shell": true,
"layer-shell-cover-screen": true,

"control-center-positionX": "right",
"control-center-positionY": "top",

"control-center-margin-top": 42,
"control-center-margin-right": 12,
"control-center-margin-bottom": 12,
"control-center-margin-left": 12,

"control-center-width": 390,
"control-center-height": -1,

"notification-window-width": 360,

"control-center-exclusive-zone": false,

"keyboard-shortcuts": true,

"timeout": 5,
"timeout-low": 3,
"timeout-critical": 0,

"transition-time": 200,

"fit-to-screen": true,

"hide-on-clear": true,

"image-visibility": "when-available",

"widgets": [
    "title",
    "dnd",
    "buttons-grid",
    "volume",
    "backlight",
    "mpris",
    "notifications"
],

"widget-config": {

    "title": {
        "text": "Domain Expansion: Control",
        "clear-all-button": true,
        "button-text": "zz"
    },

    "dnd": {
        "text": "Do Not Disturb"
    },

    "buttons-grid": {
        "buttons-per-row": 2,

        "actions": [
            {
                "label": "󰤨\nWi-Fi",
                "type": "toggle",
                "active": true,
                "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
                "update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
            },

            {
                "label": "󰂯\nBluetooth",
                "type": "toggle",
                "active": true,
                "command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
                "update-command": "sh -c 'bluetoothctl show 2>/dev/null | grep -q \"Powered: yes\" && echo true || echo false'"
            },

            {
                "label": "󰍉\nLauncher",
                "command": "rofi -show drun -theme ~/.config/rofi/main.rasi"
            },

            {
                "label": "󰸉\nWallpaper",
                "command": "~/.config/rofi/wal-menu.sh"
            },

            {
                "label": "\nPower",
                "command": "~/.config/rofi/RofiPower.sh"
            }
        ]
    },

    "volume": {
        "label": "󰕾",
        "show-per-app": false,
        "animation-type": "slide_down",
        "animation-duration": 180
    },

    "backlight": {
        "label": "󰃟",
        "device": "intel_backlight",
        "subsystem": "backlight",
        "min": 5
    },

    "mpris": {
        "autohide": true,
        "loop-carousel": true
    }
}
}
